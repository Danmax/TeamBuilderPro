{
  "name": "team-builder-pro-realtime",
  "version": "1.0.0",
  "private": true,
  "description": "Realtime backend for Team Builder Pro using Socket.IO",
  "main": "server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "check": "node --check server.js && node --test",
    "test": "node --test",
    "check:database": "node --env-file-if-exists=.env scripts/check-database.js"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "mysql2": "^3.24.6",
    "pg": "^8.13.1",
    "qs": "6.16.0",
    "socket.io": "^4.8.1"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
