PORT=3000
ADMIN_TOKEN=

# Optional database-backed global settings and question collections.
# Hosted app on Hostinger: use DB_HOST=127.0.0.1.
# Local connection to Hostinger: use the remote host shown in hPanel.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=your_database
# DB_USER=your_database_user
# DB_PASSWORD=
# MYSQL_SSL_MODE=disable
# Remote connections default to verified TLS; use verify_identity for those.
# MYSQL_SSL_MODE=verify_identity
# DB_SSL_CA=

# Alternatively use a mysql:// or postgres:// connection URL.
# DATABASE_URL=
# PGSSL=disable
